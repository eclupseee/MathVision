# Скопируйте этот файл в .env и впишите токен от @BotFather.
BOT_TOKEN=
MAX_PHOTO_MB=10
LOG_LEVEL=INFO

# Распознавание
OCR_ENGINE=tesseract
OCR_LANGS=rus+eng
TESSERACT_CMD=
OCR_TIMEOUT_SECONDS=60

# Ollama Cloud
OLLAMA_MODEL=gemma4:cloud
OLLAMA_SOLVER_MODEL=gpt-oss:120b-cloud
OLLAMA_TIMEOUT_SECONDS=180
